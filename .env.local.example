# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed to source control.

# MongoDB Atlas Connection URI
# Sign up at https://www.mongodb.com/cloud/atlas (Free M0 Sandbox cluster available)
# In Atlas: Deployment -> Database -> Connect -> Drivers -> Node.js
# Replace <username>, <password>, and <cluster> with your credentials:
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/celebratekaro?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/celebratekaro?retryWrites=true&w=majority

# Optional: Database name (defaults to 'celebratekaro' or database from URI)
MONGODB_DB_NAME=celebratekaro

# Required for live AI features (Personalized Checklist, Grounded Chat Assistant, Vendor RFQ Drafter)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI model (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
